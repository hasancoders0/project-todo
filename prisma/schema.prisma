
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TodoStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id        String   @id @default(cuid())
  username  String?  @unique
  name      String
  email     String?  @unique
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProjects    Project[]        @relation("ProjectCreator")
  projectMemberships ProjectMember[]
  createdTodos       Todo[]           @relation("TodoCreator")
  assignedTodos      Todo[]           @relation("TodoAssignee")
  completedTodos     Todo[]           @relation("TodoCompleter")
  completions        TodoCompletion[]
  todoStatusChanges  TodoStatusHistory[] @relation("TodoStatusChangedBy")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  startAt     DateTime?
  deadlineAt  DateTime
  status      ProjectStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  creator User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members ProjectMember[]
  todos   Todo[]

  @@index([createdById])
  @@index([status, deadlineAt])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Todo {
  id                  String     @id @default(cuid())
  projectId           String
  title               String
  description         String?
  priority            Priority   @default(MEDIUM)
  status              TodoStatus @default(PENDING)
  createdById         String
  assigneeId          String
  deadlineAt          DateTime
  focusDurationMinutes Int       @default(25)
  completedAt         DateTime?
  completedById       String?
  completionMessage   String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator       User                @relation("TodoCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee      User                @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  completedBy   User?               @relation("TodoCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  completions   TodoCompletion[]
  statusHistory TodoStatusHistory[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([deadlineAt])
}

model TodoCompletion {
  id            String   @id @default(cuid())
  todoId        String
  completedById String
  message       String
  completedAt   DateTime @default(now())

  todo        Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  completedBy User @relation(fields: [completedById], references: [id], onDelete: Restrict)

  @@index([todoId, completedAt])
}

model TodoStatusHistory {
  id          String     @id @default(cuid())
  todoId      String
  changedById String
  fromStatus  TodoStatus
  toStatus    TodoStatus
  reason      String?
  changedAt   DateTime   @default(now())

  todo      Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  changedBy User @relation("TodoStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([todoId, changedAt])
  @@index([changedById, changedAt])
}
